{
    "welcomeFile": "epmui/webapp/index.html",
    "authenticationMethod": "route",
    "sessionTimeout": 100,
    "routes": [
        {
            "source": "^/epmui/(.*)",
            "target": "/$1",
            "localDir": "epmui/",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/(.*)$",
            "authenticationType": "xsuaa",
            "destination": "srv-api"
        }
    ]
}
